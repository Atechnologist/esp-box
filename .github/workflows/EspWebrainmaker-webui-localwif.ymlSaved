name: ESP32-S3-BOX CLEAN STABLE BUILD (RainMaker + WebUI + AP fallback)

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    container:
      image: espressif/idf:release-v5.1

    steps:
      # ---------------------------
      # CHECKOUT
      # ---------------------------
      - name: Checkout ESP-BOX
        uses: actions/checkout@v4
        with:
          repository: espressif/esp-box
          submodules: recursive
          fetch-depth: 0

      - name: Safe directory fix
        run: git config --global --add safe.directory '*'

      # ---------------------------
      # CLEAN BUILD STATE (IMPORTANT FIX)
      # ---------------------------
      - name: Clean ESP-IDF build cache
        run: |
          rm -rf examples/factory_demo/build || true
          rm -rf build || true

      # ---------------------------
      # FIX COMPONENT MANAGER
      # ---------------------------
      - name: Enable Component Manager
        run: echo "IDF_COMPONENT_MANAGER=1" >> $GITHUB_ENV

      # ---------------------------
      # REMOVE ANY BROKEN TOUCH/LCD PATCHES (SAFE)
      # ---------------------------
      - name: Fix component conflicts
        run: |
          find . -name "idf_component.yml" -exec sed -i '/esp-lcd-touch/d' {} \; || true
          find . -name "idf_component.yml" -exec sed -i '/ili9341/d' {} \; || true

      # ---------------------------
      # CREATE AP FALLBACK (SAFE COMPONENT)
      # ---------------------------
      - name: Add AP fallback
        run: |
          cat > examples/factory_demo/main/ap_fallback.c << 'EOF'
          #include "esp_wifi.h"
          #include "esp_log.h"

          static const char *TAG = "AP_FALLBACK";

          void start_ap_fallback(void)
          {
              wifi_config_t ap_config = {
                  .ap = {
                      .ssid = "ESP32-BOX-SETUP",
                      .password = "12345678",
                      .channel = 6,
                      .max_connection = 4,
                      .authmode = WIFI_AUTH_WPA_WPA2_PSK
                  }
              };

              esp_wifi_set_mode(WIFI_MODE_AP);
              esp_wifi_set_config(WIFI_IF_AP, &ap_config);
              esp_wifi_start();

              ESP_LOGI(TAG, "AP fallback started");
          }
          EOF

      # ---------------------------
      # CREATE WEB SERVER
      # ---------------------------
      - name: Add Web Server (SAFE)
        run: |
          cat > examples/factory_demo/main/web_server.c << 'EOF'
          #include "esp_http_server.h"
          #include "esp_log.h"

          static const char *TAG = "WEB";

          extern void app_pwm_led_set_power(bool on);

          static bool state = false;

          static esp_err_t root_handler(httpd_req_t *req)
          {
              const char html[] =
              "<html><body style='text-align:center;'>"
              "<h1>ESP32-S3-BOX</h1>"
              "<button onclick=\"fetch('/toggle')\">Toggle LED</button>"
              "</body></html>";

              httpd_resp_send(req, html, HTTPD_RESP_USE_STRLEN);
              return ESP_OK;
          }

          static esp_err_t toggle_handler(httpd_req_t *req)
          {
              state = !state;
              app_pwm_led_set_power(state);
              httpd_resp_send(req, "OK", HTTPD_RESP_USE_STRLEN);
              return ESP_OK;
          }

          void web_server_start(void)
          {
              httpd_config_t config = HTTPD_DEFAULT_CONFIG();
              httpd_handle_t server = NULL;

              if (httpd_start(&server, &config) == ESP_OK) {

                  httpd_uri_t root = {
                      .uri = "/",
                      .method = HTTP_GET,
                      .handler = root_handler
                  };

                  httpd_uri_t toggle = {
                      .uri = "/toggle",
                      .method = HTTP_GET,
                      .handler = toggle_handler
                  };

                  httpd_register_uri_handler(server, &root);
                  httpd_register_uri_handler(server, &toggle);

                  ESP_LOGI(TAG, "Web server started");
              }
          }
          EOF

      # ---------------------------
      # CREATE HEADER (FIX YOUR ERROR)
      # ---------------------------
      - name: Add web_server.h (FIX CRASH)
        run: |
          cat > examples/factory_demo/main/web_server.h << 'EOF'
          #pragma once

          #ifdef __cplusplus
          extern "C" {
          #endif

          void web_server_start(void);

          #ifdef __cplusplus
          }
          #endif
          EOF

      # ---------------------------
      # FIX main.c SAFELY (NO .c INCLUDES)
      # ---------------------------
      - name: Patch main.c safely
        run: |
          FILE=examples/factory_demo/main/main.c

          # remove bad includes if injected before
          sed -i '/web_server.h/d' $FILE || true
          sed -i '/ap_fallback.c/d' $FILE || true

          # add correct include
          grep -q 'web_server.h' $FILE || \
          sed -i '/#include "app_rmaker.h"/a #include "web_server.h"' $FILE

          # ensure web server starts AFTER system init
          grep -q 'web_server_start' $FILE || \
          sed -i '/app_rmaker_start()/a \
          vTaskDelay(pdMS_TO_TICKS(4000));\
          web_server_start();' $FILE

      # ---------------------------
      # BUILD
      # ---------------------------
      - name: Build firmware
        run: |
          . $IDF_PATH/export.sh
          cd examples/factory_demo
          idf.py set-target esp32s3
          cp sdkconfig.ci.box sdkconfig
          idf.py reconfigure
          idf.py build

      # ---------------------------
      # MERGE BIN
      # ---------------------------
      - name: Merge firmware
        run: |
          . $IDF_PATH/export.sh
          cd examples/factory_demo/build

          python $IDF_PATH/components/esptool_py/esptool/esptool.py \
            --chip esp32s3 merge_bin \
            -o factory_merged.bin \
            --flash_mode dio \
            --flash_size 16MB \
            $(cat flash_args)

      # ---------------------------
      # ARTIFACT
      # ---------------------------
      - name: Upload firmware
        uses: actions/upload-artifact@v4
        with:
          name: esp32s3-box-stable-build
          path: examples/factory_demo/build/factory_merged.bin
