name: ESP32-S3-BOX AI VOICE ROUTER (LOCAL SR + WEBUI)

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest

    container:
      image: espressif/idf:release-v5.1

    defaults:
      run:
        shell: bash

    steps:

      - name: Checkout ESP-BOX
        uses: actions/checkout@v4
        with:
          repository: espressif/esp-box
          submodules: recursive
          fetch-depth: 0

      - name: Safe dir
        run: git config --global --add safe.directory '*'

      - name: Clean
        run: |
          rm -rf examples/factory_demo/build
          rm -rf examples/factory_demo/managed_components
          rm -rf examples/factory_demo/dependencies.lock

      - name: Restore original manifest
        run: |
          cd examples/factory_demo
          git checkout idf_component.yml || true

      - name: Enable Component Manager
        run: echo "IDF_COMPONENT_MANAGER=1" >> $GITHUB_ENV

      # =========================
      # AI INTENT PARSER
      # =========================
      - name: Add ai_voice_router
        run: |
          cat > examples/factory_demo/main/ai_voice_router.h << 'HEOF'
          #pragma once
          #ifdef __cplusplus
          extern "C" {
          #endif

          void ai_voice_process(const char *text);

          #ifdef __cplusplus
          }
          #endif
          HEOF

          cat > examples/factory_demo/main/ai_voice_router.c << 'HEOF'
          #include "ai_voice_router.h"
          #include "command_router.h"
          #include <string.h>
          #include <stdio.h>

          static int contains(const char *text, const char *word)
          {
              return strstr(text, word) != NULL;
          }

          void ai_voice_process(const char *text)
          {
              if (!text) return;

              printf("VOICE: %s\n", text);

              if (contains(text, "light") || contains(text, "led"))
              {
                  if (contains(text, "on") || contains(text, "start"))
                      command_router_execute("LED_ON");

                  else if (contains(text, "off") || contains(text, "stop"))
                      command_router_execute("LED_OFF");
              }
              else if (contains(text, "remote"))
              {
                  command_router_execute("REMOTE_ON");
              }
              else if (contains(text, "send"))
              {
                  command_router_execute("ESPNOW_ON");
              }
          }
          HEOF

      # =========================
      # COMMAND ROUTER
      # =========================
      - name: Add command_router
        run: |
          cat > examples/factory_demo/main/command_router.h << 'HEOF'
          #pragma once
          #ifdef __cplusplus
          extern "C" {
          #endif

          void command_router_execute(const char *cmd);

          #ifdef __cplusplus
          }
          #endif
          HEOF

          cat > examples/factory_demo/main/command_router.c << 'HEOF'
          #include "command_router.h"
          #include "app_led.h"
          #include <string.h>
          #include <stdio.h>

          void command_router_execute(const char *cmd)
          {
              if (!cmd) return;

              printf("CMD: %s\n", cmd);

              if (strcmp(cmd, "LED_ON") == 0)
                  app_pwm_led_set_power(true);

              else if (strcmp(cmd, "LED_OFF") == 0)
                  app_pwm_led_set_power(false);
          }
          HEOF

      # =========================
      # WEB UI
      # =========================
      - name: Add web_server
        run: |
          cat > examples/factory_demo/main/web_server.h << 'HEOF'
          #pragma once
          void web_server_start(void);
          HEOF

          cat > examples/factory_demo/main/web_server.c << 'HEOF'
          #include "web_server.h"
          #include "esp_http_server.h"
          #include "app_led.h"

          static httpd_handle_t server = NULL;

          static esp_err_t root(httpd_req_t *req)
          {
              const char html[] =
              "<h1>ESP32 Voice AI</h1>"
              "<button onclick=\"fetch('/on')\">ON</button>"
              "<button onclick=\"fetch('/off')\">OFF</button>";
              httpd_resp_send(req, html, HTTPD_RESP_USE_STRLEN);
              return ESP_OK;
          }

          static esp_err_t on(httpd_req_t *req)
          {
              app_pwm_led_set_power(true);
              httpd_resp_send(req, "ON", HTTPD_RESP_USE_STRLEN);
              return ESP_OK;
          }

          static esp_err_t off(httpd_req_t *req)
          {
              app_pwm_led_set_power(false);
              httpd_resp_send(req, "OFF", HTTPD_RESP_USE_STRLEN);
              return ESP_OK;
          }

          void web_server_start(void)
          {
              if (server) return;

              httpd_config_t config = HTTPD_DEFAULT_CONFIG();
              httpd_start(&server, &config);

              httpd_uri_t r = {.uri="/", .method=HTTP_GET, .handler=root};
              httpd_uri_t o = {.uri="/on", .method=HTTP_GET, .handler=on};
              httpd_uri_t f = {.uri="/off", .method=HTTP_GET, .handler=off};

              httpd_register_uri_handler(server, &r);
              httpd_register_uri_handler(server, &o);
              httpd_register_uri_handler(server, &f);
          }
          HEOF

      # =========================
      # PATCH CMAKE
      # Python used instead of sed to avoid brittle regex
      # and YAML quoting issues with inline sed expressions.
      # =========================
      - name: Patch CMake
        run: |
          python3 - << 'PYEOF'
          import pathlib, re

          cmake_path = pathlib.Path("examples/factory_demo/main/CMakeLists.txt")
          src = cmake_path.read_text()

          if "ai_voice_router.c" not in src:
              new_files = ["ai_voice_router.c", "command_router.c", "web_server.c"]

              def insert_srcs(match):
                  indent = "        "
                  extras = "".join(f"\n{indent}{f}" for f in new_files)
                  return match.group(0) + extras

              src = re.sub(r'SRCS\b', insert_srcs, src, count=1)
              cmake_path.write_text(src)
              print("CMakeLists.txt patched")
          else:
              print("CMakeLists.txt already patched, skipping")
          PYEOF

      # =========================
      # PATCH SR HANDLER
      # Injects ai_voice_process() call after the speech
      # recognition log line in app_sr_handler.c.
      # Python used instead of multiline sed — the original
      # sed -i '/.../a \' block is invalid YAML syntax.
      # =========================
      - name: Inject AI into speech pipeline
        run: |
          python3 - << 'PYEOF'
          import pathlib, re

          sr_path = pathlib.Path("examples/factory_demo/main/app/app_sr_handler.c")
          if not sr_path.exists():
              # Try alternate location
              sr_path = pathlib.Path("examples/factory_demo/main/app_sr_handler.c")

          if not sr_path.exists():
              print("WARNING: app_sr_handler.c not found, searching...")
              import subprocess
              result = subprocess.run(
                  ["find", "examples/factory_demo", "-name", "app_sr_handler.c"],
                  capture_output=True, text=True
              )
              found = result.stdout.strip().splitlines()
              if not found:
                  raise FileNotFoundError("app_sr_handler.c not found anywhere")
              sr_path = pathlib.Path(found[0])
              print(f"Found at: {sr_path}")

          src = sr_path.read_text()

          if "ai_voice_process" in src:
              print("SR handler already patched, skipping")
          else:
              # Add include at top if not present
              if '"ai_voice_router.h"' not in src:
                  src = '#include "ai_voice_router.h"\n' + src

              # Insert ai_voice_process() call after the ESP_LOGI line
              # that logs the recognised phrase
              src = re.sub(
                  r'(ESP_LOGI\s*\([^)]*recog[^)]*\)\s*;)',
                  r'\1\n    ai_voice_process(result->phrase);',
                  src
              )
              sr_path.write_text(src)
              print(f"SR handler patched: {sr_path}")
          PYEOF

      # =========================
      # PATCH MAIN
      # =========================
      - name: Patch main
        run: |
          python3 - << 'PYEOF'
          import pathlib, re

          f = pathlib.Path("examples/factory_demo/main/main.c")
          s = f.read_text()

          inc = '\n#include "web_server.h"\n#include "ai_voice_router.h"\n'

          m = list(re.finditer(r'^#include.*$', s, re.M))
          if m and "ai_voice_router.h" not in s:
              s = s[:m[-1].end()] + inc + s[m[-1].end():]

          if "web_server_start();" not in s:
              s = s.replace(
                  "app_rmaker_start();",
                  "app_rmaker_start();\n    web_server_start();"
              )

          f.write_text(s)
          print("main.c patched")
          PYEOF

      # =========================
      # BUILD
      # =========================
      - name: Build
        run: |
          source $IDF_PATH/export.sh
          cd examples/factory_demo
          idf.py set-target esp32s3
          cp sdkconfig.ci.box sdkconfig
          idf.py fullclean
          idf.py build

      # =========================
      # MERGE
      # =========================
      - name: Merge
        run: |
          source $IDF_PATH/export.sh
          cd examples/factory_demo/build
          python $IDF_PATH/components/esptool_py/esptool/esptool.py \
            --chip esp32s3 merge_bin \
            -o factory.bin \
            @flash_args

      - name: Upload
        uses: actions/upload-artifact@v4
        with:
          name: esp32-ai-voice-router
          path: examples/factory_demo/build/factory.bin

