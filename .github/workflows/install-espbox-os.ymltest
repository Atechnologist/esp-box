name: Install ESP-BOX OS

on:
  workflow_dispatch:

jobs:
  install:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Verify repository
        run: |
          pwd
          ls -la
          echo "Patch files:"
          find patches -type f || true

      - name: Install ESP-NOW Manager
        run: |
          mkdir -p examples/factory_demo/main/core/espnow_manager

          cp -rv patches/core/espnow_manager/. \
          examples/factory_demo/main/core/espnow_manager/

      - name: Verify installation
        run: |
          find examples/factory_demo/main/core
